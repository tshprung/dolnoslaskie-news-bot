TELEGRAM_BOT_TOKEN=your_dolnoslaskie_bot_token_here
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
ADMIN_TELEGRAM_ID=your_personal_telegram_id_here
OPENAI_API_KEY=your_openai_api_key_here
DB_PATH=/opt/dolnoslaskie_news/seen.db

# Set to 1 to test without posting to Telegram (still calls OpenAI).
DRY_RUN=0
# DRY_RUN_MAX_POSTS=5

# Delivery: accepted stories are queued and sent as one daily brief.
NEWS_DIGEST_ENABLED=1
NEWS_DIGEST_HOUR=19
NEWS_DIGEST_MAX_ITEMS=10

# Link previews (Telegram-generated preview cards).
# Set to 0 if you don't want preview cards under posts.
# TELEGRAM_LINK_PREVIEW_ENABLED=1

# Explicit images (bot uploads a hero image via sendPhoto when one is found).
# Off by default; enable if your channel often misses preview images.
# TELEGRAM_IMAGES_ENABLED=1
# If 1, require the image host to exactly match the article host (stricter, fewer images).
# TELEGRAM_IMAGES_STRICT=0

# WEEKLY_ANNOUNCE_ENABLED=0
# WEEKLY_ANNOUNCE_TZ=Europe/Warsaw
# WEEKLY_ANNOUNCE_WEEKDAY=6
# WEEKLY_ANNOUNCE_HOUR=18
