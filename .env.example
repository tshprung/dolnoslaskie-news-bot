TELEGRAM_BOT_TOKEN=your_dolnoslaskie_bot_token_here
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
ADMIN_TELEGRAM_ID=your_personal_telegram_id_here
OPENAI_API_KEY=your_openai_api_key_here
DB_PATH=/opt/dolnoslaskie_news/seen.db

# Set to 1 to test without posting to Telegram (still calls OpenAI).
DRY_RUN=0
# DRY_RUN_MAX_POSTS=5

# Link preview (raw URL line) + sendMessage.
# TELEGRAM_LINK_PREVIEW_ENABLED=1

# Optional: send article hero image via sendPhoto (caption = summary + link). Default off.
# TELEGRAM_IMAGES_ENABLED=0
# Strict: image host must match article host or subdomain (1). If 0, same registrable domain (e.g. *.wp.pl) allowed.
# TELEGRAM_IMAGES_STRICT=1

# WEEKLY_ANNOUNCE_ENABLED=0
# WEEKLY_ANNOUNCE_TZ=Europe/Warsaw
# WEEKLY_ANNOUNCE_WEEKDAY=6
# WEEKLY_ANNOUNCE_HOUR=18
